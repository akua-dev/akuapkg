#!/usr/bin/env bash
# Pre-push hook — keep the default gate non-mutating. The full local CI gate
# builds sandbox artifacts and may clone/patch third-party engine sources, so
# it is opt-in instead of running on every push.
#
# Install: `task hooks:install` (sets `core.hooksPath = .githooks`).

set -e

if ! command -v task >/dev/null 2>&1; then
  echo "pre-push: \`task\` not on PATH; install via \`mise install\` or skip with --no-verify" >&2
  exit 1
fi

if [[ "${PRE_PUSH_FULL:-}" == "1" ]]; then
  echo "pre-push: full local gate requested via PRE_PUSH_FULL=1"
  task ci
  exit 0
fi

echo "pre-push: fmt:check"
task fmt:check

cat >&2 <<'EOF'
pre-push: skipped full local gate by default.
pre-push: run `task ci` before merge/release, or push with
pre-push: `PRE_PUSH_FULL=1 git push` to run it from this hook.
EOF
